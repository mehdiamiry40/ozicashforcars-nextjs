{
  "name": "ozicashforcars-nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && npm run test:integration",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "playwright test",
    "snapshot": "node scripts/snapshot-site.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "typescript": "7.0.2"
  },
  "type": "module"
}
