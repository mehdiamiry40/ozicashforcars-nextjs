# Create and verify the sender domain at https://resend.com
RESEND_API_KEY=re_replace_with_real_key
RESEND_EMAIL_DOMAIN=replace_with_verified_sender_domain
QUOTE_FROM_EMAIL=Ozi Quotes <quotes@ozicashforcars.com.au>
QUOTE_TO_EMAIL=contact@ozicashforcars.com.au
QUOTE_EMAIL_TIMEOUT_MS=8000
QUOTE_CLIENT_RATE_LIMIT=5

# Optional: Google Search Console HTML-tag verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
