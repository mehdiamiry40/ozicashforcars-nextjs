# Create and verify the sender domain at https://resend.com
DATABASE_URL=postgresql://replace_with_neon_connection_string
RESEND_API_KEY=re_replace_with_real_key
RESEND_EMAIL_DOMAIN=replace_with_verified_sender_domain
QUOTE_FROM_EMAIL=Ozi Quotes <quotes@ozicashforcars.com.au>
QUOTE_TO_EMAIL=contact@ozicashforcars.com.au
QUOTE_EMAIL_TIMEOUT_MS=8000
QUOTE_OUTBOX_ENABLED=false
QUOTE_RATE_SECRET=replace_with_64_character_random_secret
QUOTE_CLIENT_RATE_LIMIT=5
QUOTE_CONTACT_RATE_LIMIT=5
QUOTE_GLOBAL_RATE_LIMIT=100
CRON_SECRET=replace_with_64_character_random_secret
QUOTE_MONITOR_SECRET=replace_with_a_different_64_character_random_secret
